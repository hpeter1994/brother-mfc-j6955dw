+ # Arch: standard IPP job attributes sent by GTK/Qt/LibreOffice/browser
+ # print dialogs. cupsd adds the queue's print-color-mode-default to every
+ # job, so colour is mapped both ways (set the default with
+ # lpadmin -o print-color-mode-default=...). For quality only non-default
+ # choices are mapped so lpadmin -o BRResolution=... is not overridden.
+ %ipp_commandline = (
+  'print-color-mode=color'              => {"opt"=>"-corm" ,   "val"=>"FullColor"},
+  'print-color-mode=monochrome'         => {"opt"=>"-corm" ,   "val"=>"Mono"},
+  'print-color-mode=auto-monochrome'    => {"opt"=>"-corm" ,   "val"=>"Mono"},
+  'print-color-mode=process-monochrome' => {"opt"=>"-corm" ,   "val"=>"Mono"},
+  'print-quality=3'                     => {"opt"=>"-reso" ,   "val"=>"Draft"},
+  'print-quality=5'                     => {"opt"=>"-reso" ,   "val"=>"Fine"},
+  'sides=one-sided'                     => {"opt"=>"-duplex" , "val"=>"None"},
+  'sides=two-sided-long-edge'           => {"opt"=>"-duplex" , "val"=>"DuplexNoTumble"},
+  'sides=two-sided-short-edge'          => {"opt"=>"-duplex" , "val"=>"DuplexTumble"},
+  # cupsd only maps media-source/media-type inside media-col; these cover
+  # the stand-alone attributes and entries of a "media=a,b,c" list
