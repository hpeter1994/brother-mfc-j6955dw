+  'media-source=tray-1'                 => {"opt"=>"-inslot" , "val"=>"Tray1"},
+  'media-source=tray-2'                 => {"opt"=>"-inslot" , "val"=>"Tray2"},
+  'media-source=by-pass-tray'           => {"opt"=>"-inslot" , "val"=>"MPTray"},
+  'media-type=stationery'               => {"opt"=>"-md" ,     "val"=>"Plain"},
+  'media-type=photographic-glossy'      => {"opt"=>"-md" ,     "val"=>"Glossy"},
+  'media-type=stationery-inkjet'        => {"opt"=>"-md" ,     "val"=>"Inkjet"},
