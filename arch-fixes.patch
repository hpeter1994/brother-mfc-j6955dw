+# Arch: libcupsfilters 2 pdftopdf already rotates back pages 180 degrees for
+# sides=two-sided-long-edge. The Brother filter rotates them again for
+# DuplexNoTumble, so the back side would come out upside down. For PDF input
+# with that option, let the Brother filter leave back pages as they are.
+my $SPOOLED = '';
+if ( $CUPSINPUT eq '' ){
+    $SPOOLED = "$TMPDIR/br".$PRINTER."in_".$$;
+    `cat > $SPOOLED`;
+    $CUPSINPUT = $SPOOLED;
+}
+if ( $lpr_options{'-duplex'} eq 'DuplexNoTumble' &&
+     $cmdoptions =~ /(^|\s)sides=two-sided-long-edge(\s|$)/ ){
+    my $magic = '';
+    if ( open (my $in , '<' , $CUPSINPUT) ){
+	read ($in , $magic , 5);
+	close ($in);
+    }
+    if ( $magic eq '%PDF-' ){
+	$lpr_options{'-duplex'} = 'DuplexTumble';
+	logprint( 2 , "pdftopdf rotated back pages: -duplex DuplexTumble\n");
+    }
+}
+
 
 &exec_lpdconfig ( $basedir ,$PRINTER , \%lpr_options );
 
